{
  "name": "flow2spec-workspace",
  "version": "3.3.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "flow2spec-workspace",
      "version": "3.3.1",
      "workspaces": [
        "packages/core",
        "packages/cli"
      ],
      "engines": {
        "node": ">=16"
      }
    },
    "node_modules/@double-coding/flow2spec": {
      "resolved": "packages/cli",
