    "node_modules/@double-coding/flow2spec-core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@double-coding/flow2spec",
      "version": "3.3.1",
      "license": "ISC",
      "dependencies": {
        "@double-coding/flow2spec-core": "3.3.1"
      },
      "bin": {
        "flow2spec": "cli.js"
      },
      "engines": {
        "node": ">=16"
      }
    },
    "packages/core": {
      "name": "@double-coding/flow2spec-core",
      "version": "3.3.1",
      "license": "ISC",
      "engines": {
        "node": ">=16"
      }
    }
  }
